# Canonical origin (must match siteConfig.url / domain)
NEXT_PUBLIC_SITE_URL="https://www.example-wiki.wiki"

# AdSense publisher id used by /ads.txt and the head script
NEXT_PUBLIC_ADSENSE_PUB_ID="pub-XXXXXXXXXXXXXXXX"

# Adsterra native/feed sub-account id (the "plXXXXXXX" number in
# https://plXXXXXXX.effectivegatecpm.com/<key>/invoke.js)
NEXT_PUBLIC_ADSTERRA_PL=""

# Optional. Skip both unless you actually use the data — every extra tag costs LCP.
# NEXT_PUBLIC_GA_ID="G-XXXXXXXXXX"
# NEXT_PUBLIC_CLARITY_ID="xxxxxxxxxx"
