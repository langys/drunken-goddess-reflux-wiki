{
  "name": "drunkengoddessreflux-quest",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "python3 scripts/build_search_index.py --site-dir . && next build && node scripts/prepare_pages.js && npm run check:ads",
    "pages:build": "npm run build",
    "pages:deploy": "wrangler pages deploy out --project-name drunkengoddessreflux-wiki --branch main",
    "start": "next start",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "search:index": "python3 scripts/build_search_index.py --site-dir .",
    "check:content": "python3 scripts/check_content.py --site-dir .",
    "check:rebrand": "python3 scripts/check_rebrand.py --site-dir .",
    "check:links": "python3 scripts/check_links.py --out-dir out",
    "audit:freshness": "python3 scripts/refresh_audit.py --site-dir .",
    "indexnow:init": "python3 scripts/indexnow.py init --site-dir .",
    "submit:indexnow": "python3 scripts/indexnow.py submit --site-dir .",
    "audit:seo": "python3 scripts/audit_seo.py --base ${BASE:-http://localhost:3000}",
    "meta:trim": "python3 scripts/trim_meta.py --site-dir .",
    "meta:rewrite": "python3 scripts/rewrite_meta.py list --site-dir . --include-borderline --out rewrites.json",
    "check:ads": "python3 scripts/check_ads.py --out-dir out",
    "test:ads": "node --test scripts/adsterra.test.cjs",
    "test:favicons": "python3 -m unittest discover -s scripts -p 'test_make_logo.py'",
    "audit:quality": "python3 scripts/audit_content_quality.py --site-dir ."
  },
  "dependencies": {
    "geist": "^1.3.1",
    "next": "^15.1.0",
    "next-intl": "^3.26.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "gray-matter": "^4.0.3",
    "remark": "^15.0.1",
    "remark-gfm": "^4.0.1",
    "remark-html": "^16.0.1",
    "clsx": "^2.1.1",
    "tailwind-merge": "^2.5.5",
    "hast-util-sanitize": "^5.0.2",
    "mdast-util-to-hast": "^13.2.1"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "autoprefixer": "^10.4.20",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.7.2",
    "eslint": "^8.57.1",
    "eslint-config-next": "^15.1.0",
    "wrangler": "^4.138.0"
  }
}
